# Copiar como .env y completar. El .env NO se sube al repositorio.

# ---------- Base de datos (PostgreSQL) ----------
DB_NAME=soderia
DB_USER=soderia
DB_PASSWORD=cambiar

# ---------- Backend ----------
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar

# URL desde donde se abre el frontend (CORS y links de recuperación de contraseña)
FRONTEND_URL=http://localhost:8080

# Opcional: recuperación de contraseña por email
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- Frontend ----------
FRONTEND_PORT=8080
