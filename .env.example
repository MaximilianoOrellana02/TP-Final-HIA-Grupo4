# Copiar como .env y completar. El .env NO se sube al repositorio.

# ---------- Base de datos (PostgreSQL) ----------
DB_NAME=soderia
DB_USER=soderia
DB_PASSWORD=cambiar

# ---------- Backend ----------
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar

# URL desde donde se abre el frontend (CORS y links de recuperación de contraseña)
FRONTEND_URL=http://localhost:8080

# Opcional: recuperación de contraseña por email
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- Frontend ----------
FRONTEND_PORT=8080


# ---------- PGADMIN ----------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=cambia_esta_contrasena

# ---------- MantisBT (perfil incidencias) ----------
# Usar valores nuevos para esta instalación; no copiar la base ni las claves del TP6.
MANTIS_DB_ROOT_PASSWORD=cambiar
MANTIS_DB_PASSWORD=cambiar
MANTIS_CRYPTO_SALT=cambiar_por_un_valor_aleatorio_largo
MANTIS_PORT=8989
MANTIS_MAIL_PORT=8026
# Solo durante la instalación inicial, si se necesita /admin/install.php.
MANTIS_ENABLE_ADMIN=0
# Por defecto, los avisos quedan en Mailpit. Completar SMTP externo solo si
# se necesita entregar mensajes a los correos reales del equipo.
MANTIS_SMTP_HOST=mantis-correo
MANTIS_SMTP_PORT=1025
MANTIS_SMTP_CONNECTION_MODE=
MANTIS_SMTP_USER=
MANTIS_SMTP_PASSWORD=
MANTIS_FROM_EMAIL=mantis@example.invalid
