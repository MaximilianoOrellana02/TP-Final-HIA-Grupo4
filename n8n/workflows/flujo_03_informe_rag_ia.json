                  {
                      "parameters":  {
                                         "jsCode":  "// Captura el texto generado por el nodo de Gemini (Message a model)\nconst aiResponse = $json?.content?.parts?.[0]?.text || $json?.text || $(\u0027Construir Prompt Enriquecido (RAG)\u0027).first().json.promptRAG;\nconst prevData = $(\u0027Construir Prompt Enriquecido (RAG)\u0027).first().json;\n\n// Genera una marca de tiempo única (Ejemplo: 2026-11-19_03-15-00)\nconst now = new Date();\nconst timeStamp = now.toISOString().split(\u0027.\u0027)[0].replace(\u0027T\u0027, \u0027_\u0027).replace(/:/g, \u0027-\u0027);\n\nreturn [{\n  json: {\n    ...prevData,\n    reportFileName: `informe_rag_rendimiento_${timeStamp}.md`,\n    reportContent: aiResponse\n  }\n}];"
                                     },
