                  {
                      "parameters":  {
                                         "jsCode":  "const metrics = $(\u0027Obtener Métricas Prometheus\u0027).first().json?.data?.result || [];\nconst runbooks = $(\u0027Recuperar Contexto RAG (Runbooks)1\u0027).all().map(item =\u003e item.json);\n\nlet downServices = [];\nlet upServices = [];\n\nmetrics.forEach(m =\u003e {\n  const job = m.metric.job || \u0027desconocido\u0027;\n  const instance = m.metric.instance || \u0027desconocida\u0027;\n  if (m.value[1] === \u00271\u0027) {\n    upServices.push(`${job} (${instance})`);\n  } else {\n    downServices.push(`${job} (${instance})`);\n  }\n});\n\nconst total = upServices.length + downServices.length;\nconst ratio = total \u003e 0 ? ((upServices.length / total) * 100).toFixed(1) : \u00270\u0027;\n\nlet relevantContext = \u0027\u0027;\nif (downServices.length \u003e 0) {\n  relevantContext = runbooks.filter(r =\u003e r.service_name === \u0027prometheus\u0027 || r.issue_type === \u0027target_down\u0027)\n                             .map(r =\u003e r.content).join(\u0027\\n\u0027);\n} else {\n  relevantContext = \u0027Todos los servicios operan con normalidad. Seguir pautas estándar de mantenimiento.\u0027;\n}\n\nconst promptRAG = `Eres un Ingeniero DevOps Sr. Genera un reporte técnico de infraestructura en formato Markdown para el equipo de operaciones.\n\nDATOS EN TIEMPO REAL DEL CLÚSTER:\n- Disponibilidad actual: ${ratio}%\n- Servicios Activos (UP): ${upServices.join(\u0027, \u0027)}\n- Servicios Caídos (DOWN): ${downServices.length \u003e 0 ? downServices.join(\u0027, \u0027) : \u0027Ninguno\u0027}\n\nMANUALES Y PROCEDIMIENTOS OPERATIVOS RECUPERADOS (RAG):\n${relevantContext}\n\nREQUISITOS DEL INFORME:\n1. Resumen Ejecutivo claro y conciso.\n2. Evaluación Diagnóstica de los servicios.\n3. Recomendaciones y Plan de Acción basado strictly en los procedimientos del RAG brindados.\n4. Responde de forma concisa en menos de 300 palabras.`;\n\nconst dateStr = new Date().toISOString().split(\u0027T\u0027)[0];\n\nreturn [{\n  json: {\n    reportFileName: `informe_rag_rendimiento_${dateStr}.md`,\n    promptRAG: promptRAG,\n    healthRatio: `${ratio}%`,\n    status: downServices.length === 0 ? \u0027SUCCESS\u0027 : \u0027WARNING\u0027,\n    alertname: \u0027RAG_Performance_Report\u0027,\n    severity: downServices.length === 0 ? \u0027info\u0027 : \u0027warning\u0027\n  }\n}];"
                                     },
