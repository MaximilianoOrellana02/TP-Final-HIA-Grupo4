                      "id":  "abf0f5f3-a79b-4a5e-9b9e-5a1e7be7b41b",
                      "name":  "Ejecución Programada (Diaria)",
                      "type":  "n8n-nodes-base.scheduleTrigger",
                      "typeVersion":  1.2,
                      "position":  [
                                       -576,
                                       -144
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const fs = require(\u0027fs\u0027);\nconst backupPath = \u0027/backups\u0027;\n\nlet isBackupValid = false;\nlet statusMessage = \u0027\u0027;\nlet latestFile = \u0027N/A\u0027;\nlet fileSizeMB = \u00270\u0027;\nlet fileAgeHours = \u0027999\u0027;\n\ntry {\n  if (fs.existsSync(backupPath)) {\n    const files = fs.readdirSync(backupPath).filter(f =\u003e f.endsWith(\u0027.dump\u0027) || f.endsWith(\u0027.sql\u0027));\n    if (files.length \u003e 0) {\n      const stats = files.map(file =\u003e {\n        const stat = fs.statSync(`${backupPath}/${file}`);\n        return { file, mtime: stat.mtime, size: stat.size };\n      }).sort((a, b) =\u003e b.mtime - a.mtime);\n\n      const latest = stats[0];\n      latestFile = latest.file;\n      fileSizeMB = (latest.size / (1024 * 1024)).toFixed(2);\n      fileAgeHours = ((new Date() - new Date(latest.mtime)) / (1000 * 60 * 60)).toFixed(2);\n\n      if (parseFloat(fileAgeHours) \u003c= 25 \u0026\u0026 latest.size \u003e 0) {\n        isBackupValid = true;\n        statusMessage = `Backup correcto: ${latestFile} (${fileSizeMB} MB, generado hace ${fileAgeHours}hs).`;\n      } else {\n        statusMessage = `ALERTA: El backup ${latestFile} está desactualizado (${fileAgeHours}hs) o corrupto.`;\n      }\n    } else {\n      statusMessage = \u0027ALERTA CRÍTICA: No se encontraron archivos de backup (.dump / .sql) en /backups.\u0027;\n    }\n  } else {\n    statusMessage = \u0027ALERTA CRÍTICA: El directorio /backups no existe o no está montado en n8n.\u0027;\n  }\n} catch (error) {\n  statusMessage = `Error al verificar backups: ${error.message}`;\n}\n\nreturn [{\n  json: {\n    isBackupValid,\n    statusMessage,\n    latestFile,\n    fileSizeMB,\n    fileAgeHours,\n    alertname: \u0027PostgresBackupVerification\u0027,\n    severity: isBackupValid ? \u0027info\u0027 : \u0027critical\u0027,\n    mantisPriority: \u0027high\u0027,\n    mantisSeverity: \u0027major\u0027\n  }\n}];"
                                     },
